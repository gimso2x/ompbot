{
	"_proposal": "Example ompbot checks to MERGE into the `checks` array of your ops-check config (~/.config/ops-check/config.json). Replace @BUN@ (absolute bun path), @REPO_DIR@ (this checkout) and @HOME@ (the home that holds .ompbot) and set host to your host name. Ids are unique and prefixed `ompbot-`.",
	"host": "@HOST@",
	"checks": [
		{
			"id": "svc-ompbot.service",
			"label": "ompbot 데몬",
			"type": "systemd",
			"unit": "ompbot.service",
			"user": true,
			"severity": "alert"
		},
		{
			"id": "ompbot-status",
			"label": "ompbot 상태 응답",
			"type": "cmd",
			"cmd": "@BUN@ @REPO_DIR@/src/main.ts status",
			"expect": "데몬 실행 중",
			"timeout": 20,
			"severity": "alert"
		},
		{
			"id": "ompbot-backup-age",
			"label": "ompbot DB 백업",
			"type": "file_age",
			"path": "@HOME@/.ompbot/backups/last-backup.ok",
			"max_hours": 36,
			"min_bytes": 1,
			"severity": "alert"
		},
		{
			"id": "ompbot-gates",
			"label": "ompbot 게이트",
			"type": "cmd",
			"cmd": "@BUN@ @REPO_DIR@/src/main.ts gates",
			"expect": "",
			"timeout": 30,
			"severity": "alert"
		}
	]
}
