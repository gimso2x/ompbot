{
	"display_information": {
		"name": "ompbot-peer",
		"description": "오너 전용 omp 코딩 에이전트 봇 — DM이나 초대된 채널에서 일을 시키면 같은 스레드에서 답합니다.",
		"background_color": "#2b2d42"
	},
	"features": {
		"app_home": {
			"home_tab_enabled": false,
			"messages_tab_enabled": true,
			"messages_tab_read_only_enabled": false
		},
		"bot_user": {
			"display_name": "ompbot-peer",
			"always_online": true
		}
	},
	"oauth_config": {
		"scopes": {
			"bot": [
				"channels:history",
				"channels:read",
				"chat:write",
				"groups:history",
				"groups:read",
				"im:history",
				"im:read",
				"im:write",
				"mpim:history",
				"mpim:read",
				"reactions:write",
				"files:read",
				"files:write",
				"commands"
			]
		}
	},
	"settings": {
		"event_subscriptions": {
			"bot_events": ["message.channels", "message.groups", "message.im", "message.mpim"]
		},
		"interactivity": {
			"is_enabled": true
		},
		"socket_mode_enabled": true,
		"org_deploy_enabled": false,
		"token_rotation_enabled": false
	}
}
